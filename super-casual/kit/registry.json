{
  "name": "super-casual",
  "title": "Super Casual UI Kit",
  "description": "Chunky, glossy mobile game UI for hyper-casual and casual 2D/3D web games. Plain HTML + CSS components that float above any game canvas (Three.js, Babylon, Phaser, PixiJS).",
  "version": "0.10.0",
  "items": [
    {
      "name": "core",
      "type": "registry:style",
      "title": "Core",
      "description": "Font, design tokens, color palette, outlined 3D text and glossy surface. Required by every component.",
      "files": [
        "core.css",
        "sc.js",
        "assets/"
      ],
      "dependencies": []
    },
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "Chunky glossy game button with outlined 3D text.",
      "whenToUse": "Any action the player taps: play, retry, claim, buy, confirm, cancel.",
      "files": [
        "components/button/button.css"
      ],
      "docs": "components/button/button.md",
      "dependencies": [
        "core"
      ],
      "html": "<button class=\"sc-button\" data-color=\"green\">Play</button>",
      "props": {
        "data-color": {
          "type": "enum",
          "values": [
            "sky",
            "blue",
            "dark",
            "green",
            "yellow",
            "orange",
            "red",
            "purple",
            "pink",
            "mint"
          ],
          "default": "sky"
        },
        "data-size": {
          "type": "enum",
          "values": [
            "sm",
            "md",
            "lg"
          ],
          "default": "md"
        },
        "data-width": {
          "type": "enum",
          "values": [
            "full"
          ],
          "optional": true
        },
        "disabled": {
          "type": "boolean",
          "optional": true
        },
        "data-icon": {
          "type": "icon",
          "optional": true,
          "description": "Leading icon by name (see icons)"
        }
      },
      "js": {
        "SC.setLabel(el, text)": "Change the label and keep the 3D text in sync",
        "SC.setIcon(el, name)": "Change the icon"
      },
      "rules": [
        "One lg button per screen for the main action",
        "green = positive/continue/rewarded video, yellow = main play, red = destructive/quit, dark = cancel, purple = premium",
        "Popups use sm or md; secondary left, primary right",
        "Labels 1-2 words",
        "Never override colors with custom CSS; use data-color"
      ],
      "examples": [
        {
          "title": "Main action",
          "html": "<button class=\"sc-button\" data-color=\"yellow\" data-size=\"lg\">PLAY</button>"
        },
        {
          "title": "Yes / No",
          "html": "<button class=\"sc-button\" data-color=\"dark\" data-size=\"sm\">No</button>\n<button class=\"sc-button\" data-color=\"green\" data-size=\"sm\">Yes</button>"
        },
        {
          "title": "With icon",
          "html": "<button class=\"sc-button\" data-color=\"green\" data-icon=\"video\">x2 Claim</button>"
        },
        {
          "title": "Full width",
          "html": "<button class=\"sc-button\" data-color=\"green\" data-width=\"full\">RESUME</button>"
        },
        {
          "title": "Disabled",
          "html": "<button class=\"sc-button\" data-color=\"purple\" disabled>Locked</button>"
        }
      ]
    },
    {
      "name": "icon-button",
      "type": "registry:ui",
      "title": "Icon Button",
      "description": "Square or round button showing only an icon, with optional label underneath.",
      "whenToUse": "Pause, close, settings, back/next arrows, menu shortcuts (Daily, Mail, Shop).",
      "files": [
        "components/icon-button/icon-button.css"
      ],
      "docs": "components/icon-button/icon-button.md",
      "dependencies": [
        "core"
      ],
      "html": "<button class=\"sc-icon-button\" data-icon=\"pause\" aria-label=\"Pause\"></button>",
      "props": {
        "data-icon": {
          "type": "icon",
          "required": true,
          "description": "Icon name (see icons)"
        },
        "data-variant": {
          "type": "enum",
          "values": [
            "glossy",
            "flat",
            "ring"
          ],
          "default": "glossy"
        },
        "data-shape": {
          "type": "enum",
          "values": [
            "square",
            "round"
          ],
          "default": "square"
        },
        "data-color": {
          "type": "enum",
          "values": [
            "sky",
            "blue",
            "dark",
            "green",
            "yellow",
            "orange",
            "red",
            "purple",
            "pink",
            "mint"
          ],
          "default": "sky",
          "description": "glossy only"
        },
        "data-size": {
          "type": "enum",
          "values": [
            "sm",
            "md",
            "lg"
          ],
          "default": "md"
        },
        "aria-label": {
          "type": "string",
          "description": "Required when there is no visible label"
        },
        "disabled": {
          "type": "boolean",
          "optional": true
        },
        "label": {
          "type": "text",
          "optional": true,
          "description": "Plain text inside \u2192 label under the icon (use with flat)"
        }
      },
      "js": {
        "SC.setIcon(el, name)": "Change the icon"
      },
      "rules": [
        "Pause in gameplay: top-left, ring or glossy sky",
        "Close on popups: glossy red with data-icon=\"close\", top-right",
        "Glossy for important actions, flat for menus/navigation, ring over busy game scenes",
        "Always add aria-label when there is no visible label",
        "Only use icon names from icons; never invent names or draw icons with code"
      ],
      "examples": [
        {
          "title": "Pause",
          "html": "<button class=\"sc-icon-button\" data-variant=\"ring\" data-icon=\"pause\" aria-label=\"Pause\"></button>"
        },
        {
          "title": "Close",
          "html": "<button class=\"sc-icon-button\" data-color=\"red\" data-size=\"sm\" data-icon=\"close\" aria-label=\"Close\"></button>"
        },
        {
          "title": "Round next",
          "html": "<button class=\"sc-icon-button\" data-shape=\"round\" data-color=\"green\" data-icon=\"arrow-right\" aria-label=\"Next\"></button>"
        },
        {
          "title": "With label",
          "html": "<button class=\"sc-icon-button\" data-variant=\"flat\" data-size=\"lg\" data-icon=\"trophy\">Rank</button>"
        }
      ]
    },
    {
      "name": "counter",
      "type": "registry:ui",
      "title": "Resource Counter",
      "description": "Icon + dark pill + number, with optional \"+\" button. Builds itself from attributes.",
      "whenToUse": "Showing coins, gems, energy, lives, tickets \u2014 usually top-right of the HUD or home screen.",
      "files": [
        "components/counter/counter.css"
      ],
      "docs": "components/counter/counter.md",
      "dependencies": [
        "core"
      ],
      "html": "<div class=\"sc-counter\" data-icon=\"coin\" data-value=\"350\"></div>",
      "props": {
        "data-icon": {
          "type": "icon",
          "required": true
        },
        "data-value": {
          "type": "number",
          "required": true
        },
        "data-max": {
          "type": "number",
          "optional": true,
          "description": "Shows value/max"
        },
        "data-plus": {
          "type": "enum",
          "values": [
            "sky",
            "blue",
            "green",
            "yellow",
            "orange",
            "red",
            "purple",
            "pink",
            "mint"
          ],
          "optional": true,
          "description": "Adds a \"+\" button in this color"
        },
        "data-format": {
          "type": "enum",
          "values": [
            "full",
            "short"
          ],
          "default": "full"
        },
        "data-size": {
          "type": "enum",
          "values": [
            "sm",
            "md",
            "lg"
          ],
          "default": "md"
        }
      },
      "events": {
        "plus": "Dispatched on the counter when its \"+\" button is tapped"
      },
      "js": {
        "SC.setValue(el, value, { animate })": "Change the value with count-up animation and bump",
        "SC.format(n, \"short\")": "Format a number like counters do"
      },
      "rules": [
        "Top-right, 12px from edges; most important resource furthest right",
        "\"+\" color matches resource: coin orange, gem purple, energy blue, cash/ticket green",
        "Only add \"+\" when it opens a way to get more",
        "Energy and lives use data-max",
        "Use data-format=\"short\" when values can pass 100,000",
        "Always update with SC.setValue(); never write inner HTML or edit inner text"
      ],
      "examples": [
        {
          "title": "HUD resources",
          "html": "<div class=\"sc-counter\" data-icon=\"energy\" data-value=\"5\" data-max=\"5\" data-plus=\"blue\"></div>\n<div class=\"sc-counter\" data-icon=\"coin\" data-value=\"349810\" data-plus=\"orange\"></div>\n<div class=\"sc-counter\" data-icon=\"gem\" data-value=\"120\" data-plus=\"purple\"></div>"
        },
        {
          "title": "Read-only",
          "html": "<div class=\"sc-counter\" data-icon=\"heart\" data-value=\"3\"></div>"
        },
        {
          "title": "Short format",
          "html": "<div class=\"sc-counter\" data-size=\"sm\" data-icon=\"coin\" data-value=\"12500\" data-format=\"short\"></div>"
        }
      ]
    },
