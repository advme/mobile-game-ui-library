          ],
          "optional": true
        },
        "data-backdrop": {
          "type": "enum",
          "values": [
            "static"
          ],
          "optional": true
        },
        "hidden": {
          "type": "boolean",
          "description": "Start closed"
        }
      },
      "slots": {
        ".sc-popup-message": "Outlined message text",
        ".sc-popup-value": "Big yellow highlighted value",
        ".sc-popup-hint": "Small soft text",
        ".sc-panel": "Light inset card grouping items",
        ".sc-popup-section": "Darker bottom area",
        ".sc-popup-actions": "Button row; data-layout=\"stack\" for vertical",
        "[data-close]": "Any element that closes the popup when tapped"
      },
      "events": {
        "open": "Popup opened",
        "close": "Popup closed"
      },
      "js": {
        "SC.popup.open(id)": "Open",
        "SC.popup.close(id)": "Close",
        "SC.popup.toggle(id)": "Toggle"
      },
      "rules": [
        "blue = info/neutral, red = warning/hard/destructive, purple = premium/special",
        "Title 1-3 words, message 1-2 sentences, at most 3 buttons",
        "Two buttons: sm, secondary left, primary right; three or more: data-layout=\"stack\"",
        "Pause the game on open, resume on close",
        "Required choices: data-closable=\"false\" + data-backdrop=\"static\"",
        "Only one popup open at a time; never write the header or close button manually"
      ],
      "examples": [
        {
          "title": "Pause menu",
          "html": "<div class=\"sc-popup\" id=\"pause\" data-title=\"PAUSED\" data-sub=\"LEVEL 12\" hidden>\n  <div class=\"sc-popup-actions\" data-layout=\"stack\">\n    <button class=\"sc-button\" data-color=\"green\" data-size=\"lg\" data-close>RESUME</button>\n    <button class=\"sc-button\" data-color=\"yellow\">Restart</button>\n    <button class=\"sc-button\" data-color=\"red\">Quit</button>\n  </div>\n</div>"
        },
        {
          "title": "Level start",
